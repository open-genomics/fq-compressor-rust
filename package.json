{
  "name": "fqc-note-tooling",
  "private": true,
  "description": "Agent Note verification scripts (.agents/notes); Rust build/test stays in Cargo. No dependencies — tsx runs via npx.",
  "scripts": {
    "verify-agent-note-tree": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "verify-archived": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "verify-notes": "npm run verify-agent-note-tree && npm run verify-agent-note-format && npm run verify-archived",
    "archive-agent-note": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/archive-agent-note.ts",
    "check-anchors": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/check-note-anchors.ts",
    "init-board": "npx tsx .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html \"fqc notes\""
  }
}
